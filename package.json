{
  "name": "llama-launcher",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --no-daemon --filter=@llama-launcher/desktop",
    "dev:console": "pnpm --filter @llama-launcher/desktop dev:console",
    "build": "turbo run build --no-daemon",
    "lint": "turbo run lint --no-daemon && node scripts/verify-ipc-sync.cjs && node scripts/check-docs-links.cjs",
    "docs:check": "node scripts/check-docs-links.cjs",
    "style:audit": "node scripts/style-audit.cjs",
    "generate:ipc": "node scripts/generate-preload.cjs",
    "test": "turbo run test --no-daemon",
    "dist": "pnpm --filter @llama-launcher/desktop dist"
  },
  "devDependencies": {
    "resedit": "^3.1.0",
    "turbo": "^2.10.12"
  }
}
