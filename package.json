{
  "name": "llama-launcher",
  "version": "0.0.30",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --no-daemon --filter=@llama-launcher/desktop",
    "dev:console": "pnpm --filter @llama-launcher/desktop dev:console",
    "build": "turbo run build --no-daemon",
    "lint": "turbo run lint --no-daemon && node scripts/verify-ipc-sync.cjs && node scripts/check-docs-links.cjs && node scripts/verify-i18n-usage.cjs && pnpm lint:ox",
    "lint:ox": "oxlint .",
    "docs:check": "node scripts/check-docs-links.cjs",
    "style:audit": "node scripts/style-audit.cjs",
    "generate:ipc": "node scripts/generate-preload.cjs",
    "reinstall:electron": "node scripts/reinstall-electron.cjs",
    "test": "turbo run test --no-daemon",
    "e2e:web": "pnpm --filter @llama-launcher/ui build && node e2e/run-web-e2e.mjs",
    "e2e:electron": "pnpm --filter @llama-launcher/desktop build && node e2e/electron/run-smoke.mjs",
    "test:e2e": "pnpm build && pnpm exec playwright test --project=web && node e2e/electron/run-smoke.mjs",
    "dist": "pnpm --filter @llama-launcher/desktop dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "oxlint": "^1.81.0",
    "resedit": "^3.1.0",
    "turbo": "^2.10.12"
  }
}
