{
  "name": "llama-launcher",
  "version": "0.0.05",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@llama-launcher/desktop",
    "dev:console": "pnpm --filter @llama-launcher/desktop dev:console",
    "build": "turbo run build",
    "lint": "turbo run lint && node scripts/verify-ipc-sync.cjs && node scripts/check-docs-links.cjs",
    "docs:check": "node scripts/check-docs-links.cjs",
    "generate:ipc": "node scripts/generate-preload.cjs",
    "test": "turbo run test",
    "dist": "pnpm --filter @llama-launcher/desktop dist"
  },
  "devDependencies": {
    "resedit": "^3.0.2",
    "turbo": "^2.10.3"
  }
}
