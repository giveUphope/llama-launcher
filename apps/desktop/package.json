{
  "name": "@llama-launcher/desktop",
  "version": "0.0.19",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "pnpm dev:vite",
    "dev:console": "cross-env NODE_ENV=development LLAMA_DEV_CONSOLE=1 pnpm dev:vite",
    "dev:vite": "cross-env NODE_ENV=development concurrently -k --success first -n vite,tsc,electron -c magenta,cyan,blue \"pnpm --filter @llama-launcher/ui dev\" \"pnpm dev:tsc:watch\" \"pnpm dev:electron:watch\"",
    "dev:tsc:watch": "cross-env NODE_ENV=development tsc -b --watch",
    "dev:electron:watch": "cross-env NODE_ENV=development node ../../scripts/dev-watch.cjs",
    "dev:electron": "cross-env NODE_ENV=development tsc -b && node ../../scripts/copy-preload.cjs && wait-on file:../../packages/ui/.vite-dev-port && electron .",
    "build:ui": "pnpm --filter @llama-launcher/ui build",
    "build:main": "tsc -b && node ../../scripts/copy-preload.cjs && node ../../scripts/copy-ui.cjs",
    "build": "pnpm build:ui && pnpm build:main",
    "clean": "tsc -b --clean",
    "gen:icon": "node ../../scripts/icon-gen/gen-icon.cjs",
    "start": "pnpm build && cross-env NODE_ENV=production electron .",
    "start:hot": "concurrently -k --success first -n vite,electron -c magenta,blue \"pnpm --filter @llama-launcher/ui dev\" \"wait-on file:../../packages/ui/.vite-dev-port && pnpm start:hot:electron\"",
    "start:hot:electron": "cross-env NODE_ENV=production LLAMA_DEV_SERVER_URL=http://127.0.0.1:5173 tsc -b && node ../../scripts/copy-preload.cjs && electron .",
    "dist": "pnpm build && node ../../scripts/dist-with-fallback.cjs",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@llama-launcher/core": "workspace:*",
    "@llama-launcher/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0"
  }
}
